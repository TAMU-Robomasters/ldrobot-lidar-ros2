<?xml version="1.0"?>

<robot name="ldlidar">

    <link name="ldlidar_base">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ldlidar_node/urdf/model/LD19.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="ldlidar_mat">
                <color rgba="0.8 0.8 0.8 0.8"/>
            </material>
        </visual>
    </link>

    <!-- right lidar -->
    <joint name="ldlidar_link_joint" type="fixed">
        <parent link="ldlidar_base"/>
        <child link="ldlidar_link"/>
        <origin xyz="0.203324 0 0.123605" rpy="3.14 0 0" />
    </joint>

    <link name="ldlidar_link"/>


    <!-- left lidar -->
    <joint name="ldlidar2_link_joint" type="fixed">
        <parent link="ldlidar_base"/>
        <child link="ldlidar2_link"/>
        <origin xyz="-0.203324, 0, 0.1236055" rpy="3.14 0 0" />
    </joint>

    <link name="ldlidar2_link"/>

</robot>